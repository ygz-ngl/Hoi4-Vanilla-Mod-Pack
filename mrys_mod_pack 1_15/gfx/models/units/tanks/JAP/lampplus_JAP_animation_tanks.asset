### NOTE ###
# Chi means "Chu-Sensha" "medium-tank" "中-戦車";
# Ke means "Ke-Sensha" "light-tank" "輕-戦車";
# Ho means "artillery" "砲" ;
# SR means "Special" "特";
# Go means "number" "号";
# Ka means "Amphibious"
# (i):A1; (ro):B2; (ha):C3; (ni):D4; (ho):E5; (he):F6; (to):G7;


